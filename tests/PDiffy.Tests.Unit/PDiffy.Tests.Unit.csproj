<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <!-- Writes the PDFs of the other-producer tests. 6.2.4 is its last MIT release; 6.5 moved to the AGPL. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp brings in 8.0.1, which has known vulnerabilities. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Producers\Fonts\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A package reference imports this itself; a project reference doesn't. -->
  <Import Project="..\..\src\PDiffy\buildTransitive\PDiffy.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\PDiffy\PDiffy.csproj" />
    <ProjectReference Include="..\..\src\PDiffy.Cli\PDiffy.Cli.csproj" />
  </ItemGroup>

</Project>
