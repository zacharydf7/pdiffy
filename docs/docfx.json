{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [{ "src": "../src/PDiffy", "files": ["PDiffy.csproj"] }],
      "dest": "api",
      "properties": { "Configuration": "Release" },
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      { "files": ["**/*.{md,yml}"], "exclude": ["_site/**", "obj/**"] }
    ],
    "resource": [{ "files": ["images/**", "samples/**"] }],
    "output": "_site",
    "sitemap": { "baseUrl": "https://zacharydf7.github.io/pdiffy/" },
    "template": ["default", "modern", "template"],
    "globalMetadata": {
      "_appName": "PDiffy",
      "_appTitle": "PDiffy",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/mark.svg",
      "_appFooter": "PDiffy is MIT licensed. <a href=\"https://github.com/zacharydf7/pdiffy\">Source on GitHub</a> · <a href=\"https://www.nuget.org/packages/PDiffy\">NuGet</a>",
      "_enableSearch": true,
      "_disableContribution": true,
      "pdf": false
    }
  }
}
