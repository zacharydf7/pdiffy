<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pdiffy</ToolCommandName>
    <Description>The pdiffy command for PDiffy: compare two PDFs, Word files or snapshot files, print a document's snapshot, accept received snapshots, and summarize a test run for CI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PDiffy\PDiffy.csproj" />
  </ItemGroup>

</Project>
