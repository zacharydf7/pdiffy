<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Document-aware testing for PDF and Word files in .NET. Semantic snapshots, comparisons and checks built on what a document says (tag structure, text, alt text, reading order, tables, links, fonts, forms, styles and layout), not how the file is encoded. A failing test explains which element changed and on which page. Text and JSON snapshots use the same workflow.</Description>
    <!-- Ships the doc comments for IntelliSense, and fails the build on a public member without a summary. The build
         doesn't check a positional record's parameters, so give each a <param> on the record. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\PDiffy.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PDiffy.Tests.Unit" />
    <InternalsVisibleTo Include="PDiffy.Cli" />
  </ItemGroup>

</Project>
