<Project>
  <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <Nullable>enable</Nullable>
      <ImplicitUsings>enable</ImplicitUsings>
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

      <Authors>Zachary Fry</Authors>
      <Product>PDiffy</Product>
  </PropertyGroup>

  <!-- Package details shared by the library and the command-line tool. A release sets the version from its git tag. -->
  <PropertyGroup>
      <Version>0.1.0-dev</Version>
      <Copyright>Copyright (c) 2026 Zachary Fry</Copyright>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <PackageProjectUrl>https://github.com/zacharydf7/pdiffy</PackageProjectUrl>
      <RepositoryUrl>https://github.com/zacharydf7/pdiffy</RepositoryUrl>
      <PackageTags>pdf;pdf-ua;docx;word;accessibility;snapshot-testing;approval-tests;testing</PackageTags>
      <PackageReadmeFile>README.md</PackageReadmeFile>
      <IncludeSymbols>true</IncludeSymbols>
      <SymbolPackageFormat>snupkg</SymbolPackageFormat>
      <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
